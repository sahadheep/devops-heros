# ==============================================================================
# Git Ignore for DevOps Heros & Final Capstone Project
# ==============================================================================

# OS Junk Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Compressed Archives & Large Binaries
*.zip
*.tar.gz
*.tgz
*.rar
*.7z
*.iso
*.mp4
*.mov

# Node & Frontend Dependencies & Build Outputs
node_modules/
dist/
dist-ssr/
*.local

# Python Virtual Environments & Bytecode Caches
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Local Databases, Logs & Temporary Files
*.db
*.sqlite3
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Terraform Cache & State Files
.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfplan
*.tfvars

# Editor & IDE Caches
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# Milestone Notes & Draft Proofs (Keep repository strictly assignment-focused)
MILESTONE-*.md
MILESTONE-*-NOTES.md
COMPLETION-PROOF.md

